# Telegram bot token from @BotFather (required for the bot; app runs without it in dry-run mode)
TELEGRAM_BOT_TOKEN=

# Database (SQLite by default; use postgres in production)
DATABASE_URL=sqlite+aiosqlite:///./storage/ticket_watcher.db
# DATABASE_URL=postgresql+asyncpg://ticket:ticket@localhost:5432/ticket_watcher

# How often watches are checked (seconds)
CHECK_INTERVAL_SECONDS=60

# Scraper implementation: bookmyshow | mock
SCRAPER=bookmyshow

# curl_cffi browser-impersonation profile used for BookMyShow requests
BMS_IMPERSONATE=chrome
# Cap on format/language variant events fetched per watch per tick
BMS_MAX_EVENTS_PER_WATCH=20
HTTP_TIMEOUT_SECONDS=15.0

# Optional proxy for BookMyShow requests (format: http://user:pass@host:port).
# Recommended when running on a datacenter/cloud IP — BMS's bot-protection
# blocks those far more often than residential/ISP IPs. Leave empty to
# connect directly. NEVER commit a real value here; set it in the server's
# own .env only.
BMS_PROXY_URL=

LOG_LEVEL=INFO
