# Telegram bot token from @BotFather (required for the bot; app runs without it in dry-run mode)
TELEGRAM_BOT_TOKEN=

# Database (SQLite by default; use postgres in production)
DATABASE_URL=sqlite+aiosqlite:///./storage/ticket_watcher.db
# DATABASE_URL=postgresql+asyncpg://ticket:ticket@localhost:5432/ticket_watcher

# How often watches are checked (seconds)
CHECK_INTERVAL_SECONDS=60

# Scraper implementation: bookmyshow | mock
SCRAPER=bookmyshow

LOG_LEVEL=INFO
